+/* Switch the mutually exclusive ABOVE/BELOW pair in one compatibility
+ * transaction.  Wine's generic state machine intentionally sends one EWMH bit
+ * per PropertyNotify; xfwm4 can leave this specific transient chain stuck on
+ * BELOW during the return transition.  Explicit remove/add requests (the same
+ * protocol used by wmctrl) are reliable here. */
+static void set_animate_palette_net_state( struct x11drv_win_data *data, BOOL active )
+{
+    UINT above = 1 << NET_WM_STATE_ABOVE, below = 1 << NET_WM_STATE_BELOW;
+    UINT old_state = data->pending_state.net_wm_state;
+    UINT new_state = (old_state & ~(above | below)) | (active ? above : below);
+    XEvent xev = {0};
+
+    if (old_state == new_state) return;
+
+    xev.xclient.type = ClientMessage;
+    xev.xclient.window = data->whole_window;
+    xev.xclient.message_type = x11drv_atom(_NET_WM_STATE);
+    xev.xclient.display = data->display;
+    xev.xclient.send_event = True;
+    xev.xclient.format = 32;
+    xev.xclient.data.l[3] = 1;
+
+    if (old_state & (active ? below : above))
+    {
+        xev.xclient.data.l[0] = _NET_WM_STATE_REMOVE;
+        xev.xclient.data.l[1] = active ? x11drv_atom(_NET_WM_STATE_BELOW)
+                                       : x11drv_atom(_NET_WM_STATE_ABOVE);
+        XSendEvent( data->display, DefaultRootWindow( data->display ), False,
+                    SubstructureRedirectMask | SubstructureNotifyMask, &xev );
+    }
+    if (!(old_state & (active ? above : below)))
+    {
+        xev.xclient.data.l[0] = _NET_WM_STATE_ADD;
+        xev.xclient.data.l[1] = active ? x11drv_atom(_NET_WM_STATE_ABOVE)
+                                       : x11drv_atom(_NET_WM_STATE_BELOW);
+        XSendEvent( data->display, DefaultRootWindow( data->display ), False,
+                    SubstructureRedirectMask | SubstructureNotifyMask, &xev );
+    }
+
+    data->desired_state.net_wm_state = new_state;
+    data->pending_state.net_wm_state = new_state;
+    data->net_wm_state_serial = 0;
+}
