+/* Keep Adobe Animate palettes above their owner while Animate is active, but
+ * below the newly active host application after Alt-Tab/click-away.
+ *
+ * Managed palettes are controlled through _NET_WM_STATE_ABOVE.  Adobe also uses
+ * override-redirect palettes while restoring/splitting panel groups; the WM
+ * cannot stack those, so place them immediately below the external active X
+ * window and raise them again when Animate becomes active.
+ *
+ * Scope this compatibility fix to Animate.exe.  The previous unconditional
+ * owned-popup rule changed every Wine application using this GE-Proton build. */
+static void update_animate_palette_activation( BOOL active, Window host_active )
+{
+    HWND *list;
+    UINT count = 0, i;
+
+    if (!process_name || strcasecmp( process_name, "Animate.exe" )) return;
+    if (animate_palette_process_active == active) return;
+    animate_palette_process_active = active;
+
+    if (!(list = build_hwnd_list())) return;
+    while (list[count] != HWND_BOTTOM) count++;
+
+    /* build_hwnd_list is in Win32 z-order (top to bottom).  Raise bottom-to-top
+     * to preserve that order when Animate becomes active. */
+    for (i = 0; i < count; i++)
+    {
+        UINT index = active ? count - i - 1 : i;
+        struct x11drv_win_data *data;
+        DWORD style;
+
+        if (!(data = get_win_data( list[index] ))) continue;
+        style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+        if (!(style & WS_VISIBLE) || !(style & WS_POPUP) ||
+            !NtUserGetWindowRelative( data->hwnd, GW_OWNER ) ||
+            (data->rects.window.right - data->rects.window.left) <= 32 ||
+            (data->rects.window.bottom - data->rects.window.top) <= 32 ||
+            data->is_fullscreen || !data->whole_window)
+        {
+            release_win_data( data );
+            continue;
+        }
+
+        if (data->managed)
+        {
+            set_animate_palette_net_state( data, active );
+            XFlush( data->display );
+        }
+        else if (active)
+        {
+            XRaiseWindow( data->display, data->whole_window );
+            XFlush( data->display );
+        }
+        else if (host_active && host_active != root_window)
+        {
+            /* _NET_ACTIVE_WINDOW names the WM client, which xfwm reparents below
+             * a frame; it is therefore not a root sibling of our override window
+             * and cannot safely be used with CWSibling (BadMatch).  Lowering is
+             * deterministic while inactive; activation raises the group again. */
+            XLowerWindow( data->display, data->whole_window );
+            XFlush( data->display );
+        }
+        release_win_data( data );
+    }
+    free( list );
+    XFlush( x11drv_thread_data()->display );
+}
